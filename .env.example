# Shiftslot — Umgebungsvariablen (Beispielwerte, KEINE echten Secrets committen)
# Kopiere diese Datei nach .env.local und trage echte Werte ein.

# ─── Firebase Web SDK (öffentlich, im Client gebündelt) ──────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (nur serverseitig) ───────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Privater Schlüssel mit literalen \n (Vercel-Format), in Anführungszeichen.
FIREBASE_ADMIN_PRIVATE_KEY=""

# ─── Anmeldemethoden ─────────────────────────────────────────────────────────
# "true" blendet den Apple-Login ein (sonst "Bald verfügbar", deaktiviert).
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# ─── Resend (Verifizierungs-E-Mails, nur serverseitig) ───────────────────────
# Ohne RESEND_API_KEY/RESEND_FROM fällt die App auf Firebase-Mails zurück.
RESEND_API_KEY=
# Verifizierte Absenderadresse, z. B. "Shiftslot <noreply@deine-domain.tld>"
RESEND_FROM=
